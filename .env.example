# Waru settings.
#   Development: copy to .env (gitignored); run-backend-dev.sh reads it.
#   Installed service: install.sh copies this file (or your .env, if you choose) to
#   /etc/waru/waru.env, which systemd reads. Change it there with `sudoedit /etc/waru/waru.env`,
#   then `sudo systemctl restart waru.target`.
# The frontend gets the Firebase values from the backend (GET /auth/config), so it never needs
# rebuilding for a different project.

# Firebase console > Project settings > Your apps > Web app config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=

# Origins the dashboard is opened from, comma-separated, exactly as the browser's address bar shows
# them (scheme://host[:port], no path). Requests from any other origin are refused.
# Installed behind a reverse proxy, this is the proxy's address, e.g. https://dash.example.com
WARU_ALLOWED_ORIGINS=http://localhost:3001

# Installed service only: the port the API listens on (127.0.0.1 only) and the reverse proxy forwards
# to. Defaults to 3002. run-backend-dev.sh always uses 3002, which Vite's dev proxy expects, so pick
# another port if the service and the dev backend run on the same machine at the same time.
#WARU_PORT=3002

# Leave WARU_COOKIE_SECURE unset (secure) for the installed service: the reverse proxy serves HTTPS.
# run-backend-dev.sh sets it to false itself, because the dev servers are plain HTTP.
