# Copy to .env (gitignored). Read by run-backend-dev.sh; the frontend gets the Firebase values
# from the backend (GET /auth/config), so it never needs rebuilding for a different project.

# Firebase console > Project settings > Your apps > Web app config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=

# Origins the dashboard is opened from, comma-separated, exactly as the browser's address bar shows
# them (scheme://host[:port], no path). Requests from any other origin are refused.
WARU_ALLOWED_ORIGINS=http://localhost:3001
